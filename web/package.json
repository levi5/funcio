{
  "name": "funcio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Documentation site for Funcio, with runnable examples, deployed to GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && tsc --noEmit -p tsconfig.json && npm run lint && vite build",
    "postbuild": "tsx scripts/generate-sitemap.ts && tsx scripts/verify-build.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "tsx --tsconfig tsconfig.json scripts/verify-examples.ts",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write src scripts"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.19.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
